<% content_for :title, "#{t("art.heading")} — Romer Ramos" %>

<div class="container mx-auto px-6 md:px-0 my-10 md:my-20">
  <div class="mb-8 md:mb-12">
    <h1 class="text-4xl md:text-6xl font-bold mb-4">
      <%= t("art.heading_html").html_safe %>
    </h1>
    <p class="text-xl md:text-2xl font-light text-white/70 max-w-2xl">
      <%= t("art.intro") %>
    </p>
  </div>

  <% if @photos.any? %>
    <div
      class="columns-1 sm:columns-2 lg:columns-3 gap-4"
      data-controller="lightbox"
    >
      <% @photos.each_with_index do |photo, index| %>
        <button
          type="button"
          class="block w-full mb-4 break-inside-avoid cursor-zoom-in group"
          data-action="lightbox#open"
          data-lightbox-target="item"
          data-index="<%= index %>"
          data-large-url="<%= url_for(photo.image.variant(:large)) %>"
          data-title="<%= photo.display_title %>"
          data-caption="<%= photo.display_caption %>"
          aria-label="<%= photo.display_title.presence || t("art.view_photo") %>"
        >
          <%= image_tag photo.image.variant(:thumb),
                loading: "lazy",
                alt: photo.display_title.presence || t("art.photo_alt"),
                style: "aspect-ratio: #{photo.aspect_ratio}",
                class: "w-full rounded-lg object-cover bg-white/5 transition duration-200 group-hover:opacity-90 group-hover:ring-2 group-hover:ring-brand" %>
        </button>
      <% end %>
    </div>
  <% else %>
    <p class="text-white/40 text-lg font-light py-20 text-center">
      <%= t("art.empty") %>
    </p>
  <% end %>
</div>
