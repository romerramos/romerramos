<%# Full-screen lightbox overlay. Behavior lives in controllers/lightbox_controller.js %>
<div
  data-lightbox-target="overlay"
  data-action="click->lightbox#backdropClose touchstart->lightbox#touchStart touchend->lightbox#touchEnd"
  class="hidden fixed inset-0 z-50 items-center justify-center bg-navy/95 backdrop-blur-sm"
  role="dialog"
  aria-modal="true"
>
  <button type="button" data-action="lightbox#close" aria-label="<%= t("art.close") %>"
    class="absolute top-4 right-4 md:top-6 md:right-8 text-white/70 hover:text-brand text-3xl leading-none cursor-pointer">
    &times;
  </button>

  <button type="button" data-lightbox-target="prev" data-action="lightbox#prev" aria-label="<%= t("art.previous") %>"
    class="absolute left-3 md:left-8 top-1/2 -translate-y-1/2 text-white/70 hover:text-brand text-5xl leading-none cursor-pointer select-none">
    &lsaquo;
  </button>

  <button type="button" data-lightbox-target="next" data-action="lightbox#next" aria-label="<%= t("art.next") %>"
    class="absolute right-3 md:right-8 top-1/2 -translate-y-1/2 text-white/70 hover:text-brand text-5xl leading-none cursor-pointer select-none">
    &rsaquo;
  </button>

  <figure class="flex flex-col items-center max-w-[92vw] max-h-[90vh]">
    <img data-lightbox-target="image" alt=""
      class="max-w-[92vw] max-h-[78vh] object-contain rounded-lg">
    <figcaption data-lightbox-target="caption" class="hidden mt-4 text-center max-w-2xl px-4">
      <span data-lightbox-target="title" class="block font-semibold text-white"></span>
      <span data-lightbox-target="captionText" class="block text-white/60 font-light mt-1"></span>
    </figcaption>
  </figure>
</div>
