<div class="w-full max-w-4xl">
  <div class="flex items-baseline justify-between mb-1">
    <h1 class="font-bold text-3xl md:text-4xl"><%= post.title %></h1>
    <span class="text-white/40 text-sm shrink-0 ml-4">
      <%= smart_date(post.published_at || post.created_at) %>
    </span>
  </div>

  <% if local_assigns[:admin] %>
    <div class="flex items-center gap-3 mb-4">
      <%= link_to "Edit",
      edit_admin_post_path(post),
      class:
        "rounded-md px-4 py-2 bg-white/10 hover:bg-white/20 text-white text-sm font-medium transition-colors cursor-pointer" %>
      <%= button_to "Delete",
      admin_post_path(post),
      method: :delete,
      class:
        "rounded-md px-4 py-2 bg-red-500/20 hover:bg-red-500/30 text-red-400 text-sm font-medium transition-colors cursor-pointer",
      data: {
        turbo_confirm: "Are you sure you want to delete this post?",
      } %>
    </div>
  <% end %>

  <p class="italic text-white/60 text-lg mb-6">TL;DR:
    <%= post.description %></p>

  <div class="border-t border-white/10 pt-6">
    <article class="leading-relaxed prose prose-invert">
      <%== sanitize(
        marksmithed(post.content),
        tags:
          %w[table th tr td span] +
            ActionView::Helpers::SanitizeHelper
              .sanitizer_vendor
              .safe_list_sanitizer
              .allowed_tags
              .to_a,
      ) %>
    </article>
  </div>
</div>
