<div class="w-full max-w-2xl text-center">
  <h1 class="text-4xl md:text-6xl font-bold mb-4">
    Welcome to <span class="text-brand">Jot Spot</span>
  </h1>
  <p class="text-xl md:text-2xl font-light text-white/80 mb-10">
    Admin area — more features coming soon.
  </p>

  <div class="grid sm:grid-cols-2 gap-4 text-left">
    <%= link_to admin_photos_path,
      class: "block rounded-lg border border-white/10 bg-white/5 hover:border-brand p-5 transition" do %>
      <span class="block text-lg font-semibold text-brand mb-1">
        <i class="fa-solid fa-camera mr-2"></i><%= t("admin.dashboard.manage_photos") %>
      </span>
      <span class="block text-sm text-white/60 font-light">
        <%= t("admin.dashboard.manage_photos_desc") %>
      </span>
    <% end %>
  </div>
</div>
