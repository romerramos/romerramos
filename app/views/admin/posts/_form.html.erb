<%= form_with model: [:admin, post], class: "contents" do |form| %>
  <% if post.errors.any? %>
    <div class="rounded-lg border border-red-500/30 bg-red-500/10 p-4 mb-6">
      <p class="text-red-400 font-medium mb-2"><%= t("admin.posts.errors", count: post.errors.count) %></p>
      <ul class="list-disc list-inside text-red-400/80 text-sm space-y-1">
        <% post.errors.each do |error| %>
          <li><%= error.full_message %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <div class="my-5" data-controller="tabs admin--selection-rewrite" data-tabs-active-class="border-brand text-brand" data-tabs-inactive-class="border-transparent text-white/60">
    <div class="flex gap-1 border-b border-white/10 mb-6">
      <% I18n.available_locales.each_with_index do |locale, index| %>
        <button type="button"
          data-tabs-target="tab"
          data-action="tabs#select"
          data-tabs-index-param="<%= index %>"
          class="<%= index == 0 ? 'border-brand text-brand' : 'border-transparent text-white/60' %> px-4 py-2 -mb-px border-b-2 text-sm font-medium hover:text-brand transition-colors cursor-pointer">
          <%= locale.to_s.upcase %>
        </button>
      <% end %>
    </div>

    <% translations = post.post_translations.sort_by { |item| item.locale.to_s } %>
    <%= form.fields_for :post_translations, translations do |tf| %>
      <%# fields_for does its own indexing; the content field needs to know it. %>
      <% index = translations.index(tf.object) %>
      <div data-tabs-target="panel" data-locale="<%= tf.object.locale %>" class="<%= "hidden" unless index.zero? %>">
        <%= tf.hidden_field :id %>
        <%= tf.hidden_field :locale %>

        <div class="my-5 rounded-lg border border-white/10 bg-white/5 p-4">
          <label class="flex items-center gap-2 text-white/80">
            <%= tf.check_box :published, class: "h-4 w-4 rounded border-white/20 bg-white/5 text-brand focus:ring-brand" %>
            <%= t("admin.posts.published", language: tf.object.locale.upcase) %>
          </label>
          <p class="mt-1 text-xs text-white/40"><%= t("admin.posts.published_hint") %></p>

          <div class="mt-4">
            <%= tf.label :published_at, t("admin.posts.published_at"), class: "block text-sm font-medium text-white/80 mb-1" %>
            <%= tf.datetime_local_field :published_at, class: "block rounded-md border border-white/20 bg-white/5 focus:border-brand focus:ring-1 focus:ring-brand px-3 py-2.5 mt-1 w-full text-white" %>
            <p class="mt-1 text-xs text-white/40"><%= t("admin.posts.published_at_hint") %></p>
          </div>
        </div>

        <div class="my-5">
          <%= tf.label :title, t("admin.posts.title", language: tf.object.locale.upcase), class: "block text-sm font-medium text-white/80 mb-1" %>
          <%= tf.text_field :title, placeholder: t("admin.posts.title_placeholder"), class: "block rounded-md border border-white/20 bg-white/5 focus:border-brand focus:ring-1 focus:ring-brand px-3 py-2.5 mt-1 w-full placeholder-white/40 text-white" %>
        </div>

        <div class="my-5">
          <%= tf.label :description, t("admin.posts.description", language: tf.object.locale.upcase), class: "block text-sm font-medium text-white/80 mb-1" %>
          <%= tf.text_field :description, placeholder: t("admin.posts.description_placeholder"), class: "block rounded-md border border-white/20 bg-white/5 focus:border-brand focus:ring-1 focus:ring-brand px-3 py-2.5 mt-1 w-full placeholder-white/40 text-white" %>
          <p class="text-xs text-white/40 mt-1"><%= t("admin.posts.description_hint") %></p>
        </div>

        <div class="my-5">
          <div class="flex flex-wrap items-center justify-between gap-2 mb-1">
            <%= tf.label :content, t("admin.posts.content", language: tf.object.locale.upcase), class: "block text-sm font-medium text-white/80" %>

            <% if post.persisted? %>
              <%= button_tag type: :submit, name: nil,
                    formaction: admin_post_selection_rewrite_path(post), formmethod: :post,
                    data: { action: "admin--selection-rewrite#regenerateAll",
                            turbo_submits_with: t("admin.posts.selection_rewrite.pending") },
                    class: "inline-flex items-center gap-2 rounded-md bg-white/10 px-3 py-1.5 text-xs font-medium text-white hover:bg-white/20 transition-colors cursor-pointer" do %>
                <%= lucide_icon "sparkles", class: "size-3.5", "aria-hidden": "true" %>
                <%= t("admin.posts.selection_rewrite.regenerate_all", language: tf.object.locale.upcase) %>
              <% end %>
            <% end %>
          </div>

          <div id="editor_<%= tf.object.locale %>" class="dark">
            <%= render "admin/posts/content_field", post: post, translation: tf.object, index: index %>
          </div>
        </div>
      </div>
    <% end %>

    <% if post.persisted? %>
      <div hidden data-admin--selection-rewrite-target="bar"
        class="fixed bottom-6 left-1/2 z-20 w-[min(32rem,calc(100vw-2rem))] -translate-x-1/2 rounded-lg border border-white/10 bg-navy/95 p-4 shadow-xl">
        <%= hidden_field_tag "selection_rewrite[locale]", nil, data: { "admin--selection-rewrite-target": "locale" } %>
        <%= hidden_field_tag "selection_rewrite[selection]", nil, data: { "admin--selection-rewrite-target": "selection" } %>
        <%= hidden_field_tag "selection_rewrite[selection_start]", nil, data: { "admin--selection-rewrite-target": "selectionStart" } %>
        <%= hidden_field_tag "selection_rewrite[selection_end]", nil, data: { "admin--selection-rewrite-target": "selectionEnd" } %>

        <p class="text-xs font-medium uppercase tracking-wide text-white/40 mb-1">
          <%= t("admin.posts.selection_rewrite.selected") %>
        </p>
        <p data-admin--selection-rewrite-target="preview"
          class="mb-3 max-h-24 overflow-y-auto whitespace-pre-wrap rounded border border-white/10 bg-white/5 px-3 py-2 text-sm text-white/70"></p>

        <div class="flex items-center gap-2">
          <%= button_tag type: :submit, name: nil,
                formaction: admin_post_selection_rewrite_path(post), formmethod: :post,
                data: { turbo_submits_with: t("admin.posts.selection_rewrite.pending"),
                        action: "mousedown->admin--selection-rewrite#keepSelection" },
                class: "inline-flex items-center gap-2 rounded-md bg-brand px-4 py-2 text-sm font-medium leading-5 text-white hover:bg-brand/90 cursor-pointer" do %>
            <%= lucide_icon "sparkles", class: "size-4", "aria-hidden": "true" %>
            <%= t("admin.posts.selection_rewrite.regenerate") %>
          <% end %>

          <button type="button"
            data-action="mousedown->admin--selection-rewrite#keepSelection click->admin--selection-rewrite#toggleInstruction"
            data-admin--selection-rewrite-target="instructionToggle"
            aria-expanded="false"
            aria-label="<%= t("admin.posts.selection_rewrite.customize") %>"
            title="<%= t("admin.posts.selection_rewrite.customize") %>"
            class="inline-flex items-center justify-center rounded-md bg-white/10 px-2 py-2 text-white hover:bg-white/20 transition-colors cursor-pointer">
            <%= lucide_icon "chevron-down", class: "size-4", "aria-hidden": "true" %>
          </button>
        </div>

        <div hidden data-admin--selection-rewrite-target="instructionPanel" class="mt-3">
          <%= label_tag "selection_rewrite_instruction", t("admin.posts.selection_rewrite.instruction_label"), class: "block text-sm font-medium text-white/80 mb-1" %>
          <%= text_field_tag "selection_rewrite[instruction]", nil,
                id: "selection_rewrite_instruction",
                placeholder: t("admin.posts.selection_rewrite.instruction_placeholder"),
                data: { "admin--selection-rewrite-target": "instruction" },
                class: "block rounded-md border border-white/20 bg-white/5 focus:border-brand focus:ring-1 focus:ring-brand px-3 py-2.5 w-full placeholder-white/40 text-white" %>

          <%= button_tag t("admin.posts.selection_rewrite.submit"), type: :submit, name: nil,
                formaction: admin_post_selection_rewrite_path(post), formmethod: :post,
                data: { turbo_submits_with: t("admin.posts.selection_rewrite.pending") },
                class: "mt-3 inline-flex items-center justify-center rounded-md bg-brand px-4 py-2 text-sm font-medium leading-5 text-white hover:bg-brand/90 cursor-pointer" %>
        </div>
      </div>
    <% end %>
  </div>

  <div class="mt-8 flex flex-wrap items-center gap-x-4 gap-y-3">
    <%= form.submit class: "inline-flex items-center justify-center rounded-md bg-brand px-4 py-2 text-sm font-medium leading-5 text-white hover:bg-brand/90 cursor-pointer" %>
    <%= link_to t("admin.posts.cancel"), admin_posts_path, class: "whitespace-nowrap text-sm font-medium text-white/60 hover:text-white transition-colors" %>
  </div>
<% end %>
