<div class="w-full max-w-4xl">
  <% admin_translation = @post.display_translation(I18n.default_locale) %>
  <%= render "posts/post", post: @post, admin: true, translation: admin_translation %>

  <div class="mt-10">
    <%= link_to "&larr; Back to Jot Spot".html_safe,
    admin_posts_path,
    class: "text-sm font-medium text-white/60 hover:text-brand transition-colors" %>
  </div>
</div>
