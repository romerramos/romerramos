<div class="w-full max-w-4xl">
  <% if notice = flash[:notice] %>
    <p
      class="
        py-2 px-3 bg-brand/20 mb-5 text-brand font-medium rounded-lg inline-block
      "
      id="notice"
    ><%= notice %></p>
  <% end %>

  <%= render "posts/post", post: @post, admin: true %>

  <div class="mt-10">
    <%= link_to "&larr; Back to Jot Spot".html_safe,
    admin_posts_path,
    class: "text-sm font-medium text-white/60 hover:text-brand transition-colors" %>
  </div>
</div>