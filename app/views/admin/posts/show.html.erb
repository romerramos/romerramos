<div class="w-full max-w-4xl">
  <%= render "posts/post_translation", post_translation: @post.post_translation_for(I18n.default_locale) %>

  <div class="mt-6 flex items-center gap-3">
    <%= link_to "Edit",
    edit_admin_post_path(@post),
    class:
      "rounded-md px-4 py-2 bg-white/10 hover:bg-white/20 text-white text-sm font-medium transition-colors cursor-pointer" %>
    <%= button_to "Delete",
    admin_post_path(@post),
    method: :delete,
    class:
      "rounded-md px-4 py-2 bg-red-500/20 hover:bg-red-500/30 text-red-400 text-sm font-medium transition-colors cursor-pointer",
    data: {
      turbo_confirm: "Are you sure you want to delete this post?",
    } %>
  </div>

  <div class="mt-10">
    <%= link_to admin_posts_path, class: "inline-flex items-center gap-2 text-sm font-medium text-white/60 hover:text-brand transition-colors" do %>
      <%= lucide_icon "arrow-left", class: "size-4", "aria-hidden": "true" %>
      <%= t("admin.posts.back") %>
    <% end %>
  </div>
</div>
