<div class="w-full max-w-4xl">
  <div class="flex items-center justify-between mb-8">
    <h1 class="font-bold text-3xl md:text-4xl">Jot Spot</h1>
    <div class="flex items-center gap-3">
      <%= link_to t("admin.post_generations.new"),
      new_admin_post_generation_path,
      class:
        "rounded-md px-5 py-2.5 bg-white/10 hover:bg-white/20 text-white inline-block font-medium cursor-pointer text-sm" %>
      <%= link_to t("admin.posts.new"),
      new_admin_post_path,
      class:
        "rounded-md px-5 py-2.5 bg-brand hover:bg-brand/90 text-white inline-block font-medium cursor-pointer text-sm" %>
    </div>
  </div>

  <% if @posts.any? %>
    <div class="space-y-4">
      <% @posts.each do |post| %>
        <% post_translation = post.post_translation_for(I18n.default_locale) %>
        <div class="rounded-lg border border-white/10 bg-white/5 p-5">
          <div class="flex items-start justify-between gap-4">
            <div class="min-w-0 flex-1">
              <div class="flex items-center gap-2">
                <h2 class="font-semibold text-lg text-white truncate">
                  <%= post_translation&.title || "Untitled" %>
                </h2>
              </div>
              <p class="text-sm text-white/60 mt-1 truncate"><%= post_translation&.description %></p>
              <div class="mt-3 flex flex-wrap items-center gap-2 text-xs">
                <% post.post_translations.sort_by(&:locale).each do |translation| %>
                  <span
                    class="
                      rounded-full px-2 py-1 <%= translation.published? ? 'bg-brand/15 text-brand' : 'bg-white/10 text-white/50' %>
                    "
                  >
                    <%= translation.locale.upcase %>
                    <%= if translation.published?
                      t("admin.posts.published_status")
                    else
                      t("admin.posts.draft")
                    end %>
                  </span>
                <% end %>
                <span class="text-white/40">&middot;</span>
                <span>Created
                  <%= l post.created_at, format: :short %></span>
              </div>
            </div>
            <div class="flex items-center gap-3 flex-shrink-0">
              <%= link_to "View",
              admin_post_path(post),
              class: "text-sm font-medium text-white/70 hover:text-brand transition-colors" %>
              <%= link_to "Edit",
              edit_admin_post_path(post),
              class: "text-sm font-medium text-white/70 hover:text-brand transition-colors" %>
              <%= button_to "Delete",
              admin_post_path(post),
              method: :delete,
              class:
                "text-sm font-medium text-red-400 hover:text-red-300 transition-colors cursor-pointer",
              data: {
                turbo_confirm: "Are you sure you want to delete this post?",
              } %>
            </div>
          </div>
        </div>
      <% end %>
    </div>
  <% else %>
    <div class="text-center py-16 border border-white/10 rounded-lg bg-white/5">
      <p class="text-white/60 mb-4">No posts yet.</p>
      <%= link_to "Create your first post",
      new_admin_post_path,
      class:
        "rounded-md px-5 py-2.5 bg-brand hover:bg-brand/90 text-white inline-block font-medium cursor-pointer text-sm" %>
    </div>
  <% end %>
</div>
