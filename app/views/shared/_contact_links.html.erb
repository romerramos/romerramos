<ul class="font-extralight md:text-lg flex flex-wrap gap-2 my-6">
  <li>
    <a
      class="flex gap-1 items-center hover:text-brand"
      href="https://github.com/romerramos"
      target="_blank"
      rel="noopener noreferrer"
    >
      <%= lucide_icon "github", class: "size-4", "aria-hidden": "true" %>
      <%= t("home.github") %>
    </a>
  </li>
  <li>
    <a
      class="flex gap-1 items-center hover:text-brand"
      href="https://linkedin.com/in/romerramos"
      target="_blank"
      rel="noopener noreferrer"
    >
      <%= lucide_icon "linkedin", class: "size-4", "aria-hidden": "true" %>
      <%= t("home.linkedin") %>
    </a>
  </li>
  <li>
    <%= link_to(I18n.locale == :es ? "/cv_spanish.pdf" : "/cv_english.pdf",
        target: "_blank",
        class: "flex gap-1 items-center hover:text-brand") do %>
      <%= lucide_icon "file-text", class: "size-4", "aria-hidden": "true" %>
      <%= t("home.resume") %>
    <% end %>
  </li>
  <li>
    <a
      class="flex gap-1 items-center hover:text-brand"
      href="mailto:romerramos@gmail.com"
    >
      <%= lucide_icon "at-sign", class: "size-4", "aria-hidden": "true" %>
      <%= t("home.email") %>
    </a>
  </li>
  <li>
    <a class="flex gap-1 items-center hover:text-brand" href="tel:+34722781489">
      <%= lucide_icon "phone", class: "size-4", "aria-hidden": "true" %>
      <%= t("home.phone") %>
    </a>
  </li>
</ul>
